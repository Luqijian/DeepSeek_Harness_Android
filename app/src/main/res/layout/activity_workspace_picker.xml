<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_dark_elevated"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/choose_workspace"
        app:titleTextColor="@color/text_on_dark" />

    <TextView
        android:id="@+id/path"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark_elevated"
        android:ellipsize="middle"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:singleLine="true"
        android:textColor="@color/text_muted"
        android:textIsSelectable="true"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="4dp" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark_elevated"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:text="@string/direct_mode_note"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark_elevated"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/new_folder"
            style="@style/Widget.Harness.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/new_folder" />

        <Button
            android:id="@+id/enter_path"
            style="@style/Widget.Harness.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/enter_path" />

        <Button
            android:id="@+id/select"
            style="@style/Widget.Harness.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/select_this_folder" />
    </LinearLayout>
</LinearLayout>
